# Copy this file to .env and fill in values as needed.

# Optional: override default input/output directories
INPUT_DIR=data/raw
OUTPUT_DIR=outputs

# Optional: set to 1 to run in demo mode (uses synthetic data)
DEMO_MODE=0

# Optional: minimum confidence score threshold for core analysis (0.0 - 1.0)
MIN_CONFIDENCE=0.7

# Optional: minimum sample size per group for statistical tests
MIN_SAMPLE_SIZE=30

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
