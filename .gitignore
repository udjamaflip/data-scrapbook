# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
*.so

# ── Virtual environments ───────────────────────────────────────────────────────
.env
venv/
.venv/
env/
.python-version

# ── Secrets / credentials ─────────────────────────────────────────────────────
*.key
*.pem
secrets/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Data files (real data — templates and demo CSVs are committed) ─────────────
# Real user-supplied input files are never committed.
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.json
data/raw/*.parquet
!data/raw/templates/
!data/raw/*_demo.csv

# Generated intermediate and final datasets are never committed.
data/intermediate/
data/final/

# ── Outputs (auto-generated each run) ─────────────────────────────────────────
outputs/charts/
outputs/tables/

# ── Test / type-checking caches ───────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Jupyter notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE / editor ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Scratch / temporary ───────────────────────────────────────────────────────
scratch/
*.tmp
*.temp
